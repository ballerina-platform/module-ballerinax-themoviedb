# Represents the Queries record for the operation: discoverMovies
public type DiscoverMoviesQueries record {
    # possible values are: [1, 2, 3, 4, 5, 6] can be a comma (`AND`) or pipe (`OR`) separated query, can be used in conjunction with `region`
    @http:Query {name: "with_release_type"}
    int withReleaseType?;
    # use in conjunction with `watch_region`, can be a comma (`AND`) or pipe (`OR`) separated query
    @http:Query {name: "with_watch_providers"}
    string withWatchProviders?;
    int year?;
    @http:Query {name: "primary_release_date.gte"}
    string primaryReleaseDateGte?;
    # can be a comma (`AND`) or pipe (`OR`) separated query
    @http:Query {name: "with_cast"}
    string withCast?;
    @http:Query {name: "without_watch_providers"}
    string withoutWatchProviders?;
    # use in conjunction with `with_watch_monetization_types ` or `with_watch_providers `
    @http:Query {name: "watch_region"}
    string watchRegion?;
    # can be a comma (`AND`) or pipe (`OR`) separated query
    @http:Query {name: "with_genres"}
    string withGenres?;
    string language = "en-US";
    @http:Query {name: "sort_by"}
    "original_title.asc"|"original_title.desc"|"popularity.asc"|"popularity.desc"|"revenue.asc"|"revenue.desc"|"primary_release_date.asc"|"title.asc"|"title.desc"|"primary_release_date.desc"|"vote_average.asc"|"vote_average.desc"|"vote_count.asc"|"vote_count.desc" sortBy = "popularity.desc";
    # can be a comma (`AND`) or pipe (`OR`) separated query
    @http:Query {name: "with_keywords"}
    string withKeywords?;
    @http:Query {name: "include_adult"}
    boolean includeAdult = false;
    @http:Query {name: "with_runtime.lte"}
    int withRuntimeLte?;
    @http:Query {name: "with_origin_country"}
    string withOriginCountry?;
    # can be a comma (`AND`) or pipe (`OR`) separated query
    @http:Query {name: "with_people"}
    string withPeople?;
    @http:Query {name: "with_runtime.gte"}
    int withRuntimeGte?;
    @http:Query {name: "with_original_language"}
    string withOriginalLanguage?;
    @http:Query {name: "primary_release_date.lte"}
    string primaryReleaseDateLte?;
    @http:Query {name: "without_companies"}
    string withoutCompanies?;
    @http:Query {name: "vote_average.gte"}
    float voteAverageGte?;
    @http:Query {name: "vote_average.lte"}
    float voteAverageLte?;
    @http:Query {name: "vote_count.gte"}
    float voteCountGte?;
    # can be a comma (`AND`) or pipe (`OR`) separated query
    @http:Query {name: "with_crew"}
    string withCrew?;
    @http:Query {name: "release_date.lte"}
    string releaseDateLte?;
    # can be a comma (`AND`) or pipe (`OR`) separated query
    @http:Query {name: "with_companies"}
    string withCompanies?;
    @http:Query {name: "vote_count.lte"}
    float voteCountLte?;
    @http:Query {name: "release_date.gte"}
    string releaseDateGte?;
    # use in conjunction with `region`
    string certification?;
    @http:Query {name: "without_keywords"}
    string withoutKeywords?;
    # use in conjunction with the `certification`, `certification.gte` and `certification.lte` filters
    @http:Query {name: "certification_country"}
    string certificationCountry?;
    @http:Query {name: "primary_release_year"}
    int primaryReleaseYear?;
    # possible values are: [flatrate, free, ads, rent, buy] use in conjunction with `watch_region`, can be a comma (`AND`) or pipe (`OR`) separated query
    @http:Query {name: "with_watch_monetization_types"}
    string withWatchMonetizationTypes?;
    # use in conjunction with `region`
    @http:Query {name: "certification.lte"}
    string certificationLte?;
    @http:Query {name: "include_video"}
    boolean includeVideo = false;
    # use in conjunction with `region`
    @http:Query {name: "certification.gte"}
    string certificationGte?;
    int page = 1;
    string region?;
    @http:Query {name: "without_genres"}
    string withoutGenres?;
};

