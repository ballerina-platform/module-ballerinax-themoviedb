# Represents the Queries record for the operation: discoverTvSeries
public type DiscoverTvSeriesQueries record {
    # use in conjunction with `watch_region`, can be a comma (`AND`) or pipe (`OR`) separated query
    @http:Query {name: "with_watch_providers"}
    string withWatchProviders?;
    string timezone?;
    @http:Query {name: "without_watch_providers"}
